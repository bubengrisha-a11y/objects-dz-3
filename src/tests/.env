# Адрес публикации и авторизация — замените на свои: имя публикации, порт и пароль у вас другие.
# OBJECTS_URL — корень HTTP-сервиса без завершающего «/»: <адрес веб-сервера>/<имя публикации>/hs/objects
OBJECTS_URL=http://localhost/bsp-demo/hs/objects
# OBJECTS_AUTH — значение заголовка Authorization целиком (схема и учётные данные); настоящий пароль в общий репозиторий не коммитьте.
OBJECTS_AUTH=Basic 0JDQtNC80LjQvdC40YHRgtGA0LDRgtC+0YA6

# Идентификаторы демо-данных базы 1Cv8_demo.dt: в базе из этого файла они такие же.
# Подставляются в запросы objects.http (в том числе в тело создания счёта). Если база другая — возьмите UUID своих объектов через /search.
# партнёр-покупатель ООО «Альфа»
PARTNER_ID=9203492b-ea3e-11de-8634-001d600d9ad2
# контрагент ООО «Альфа»
COUNTERPARTY_ID=71a402a5-4325-11e4-9a82-bcaec5b8981a
# организация
ORGANIZATION_ID=b1edc215-ea23-11de-8634-001d600d9ad2
# подразделение
DEPARTMENT_ID=b63d5141-8d7f-11de-a1ba-005056c00008
# ответственный
RESPONSIBLE_ID=0155b0e8-5626-11e0-b5d5-005056c00008
# товар
PRODUCT_ID=b1edc239-ea23-11de-8634-001d600d9ad2
# валюта
CURRENCY_ID=b63d5149-8d7f-11de-a1ba-005056c00008
# несуществующий объект (UUID из одних нулей) — для запроса «такого объекта нет»
MISSING_ID=00000000-0000-0000-0000-000000000000
