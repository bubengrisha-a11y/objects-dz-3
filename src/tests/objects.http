# Запросы к сервису objects. Адрес, авторизация и идентификаторы — в .env рядом.
# Маршрут, обработчик которого ещё не реализован, отвечает 501.

### Найти тип по слову
# Ожидается: 200; items содержит {"name": "Документ._ДемоПоступлениеТоваров", "kind": "document"}
GET {{$dotenv OBJECTS_URL}}/types?q=поступление
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти тип по слову: регистр и «ё» не важны
# Ожидается: 200; items содержит Документ._ДемоСчетНаОплатуПокупателю
GET {{$dotenv OBJECTS_URL}}/types?q=СЧЁТ
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти тип по слову: пустое слово
# Ожидается: 400 bad_request, details[0].path = "q"
GET {{$dotenv OBJECTS_URL}}/types?q=%20
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать тип
GET {{$dotenv OBJECTS_URL}}/type?name=Документ._ДемоСчетНаОплатуПокупателю
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти объекты типа
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=Альфа
Authorization: {{$dotenv OBJECTS_AUTH}}

### Прочитать объект
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id={{$dotenv PARTNER_ID}}
Authorization: {{$dotenv OBJECTS_AUTH}}

### Создать объект — тело запроса задаёт ваша спецификация
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{}
