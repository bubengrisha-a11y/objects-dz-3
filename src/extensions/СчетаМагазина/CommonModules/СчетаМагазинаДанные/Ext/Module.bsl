Функция Подготовить(Мета, Данные, Ошибки) Экспорт
	// Только проверка и преобразование: ничего не записывается.
	Результат = Новый Структура("header,tables", Новый Соответствие, Новый Соответствие);
	Для Каждого Элемент Из Данные Цикл
		Если Элемент.Ключ <> "type" И Элемент.Ключ <> "header" И Элемент.Ключ <> "tables" Тогда
			Ошибка(Ошибки, Элемент.Ключ, "Неизвестное поле: допустимы type, header и tables");
		КонецЕсли;
	КонецЦикла;
	Схема = СчетаМагазинаМетаданные.Схема(Мета);
	Шапка = Данные.Получить("header");
	Если ТипЗнч(Шапка) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "header", "Требуется объект header: имя поля → значение");
	Иначе
		ПодготовитьПоля(Шапка, Схема.fields, Мета, "header", Результат.header, Ошибки);
		// Правило сервиса: дату документа передаёт клиент.
		Если Не СчетаМагазинаМетаданные.ЭтоСправочник(Мета) И Шапка.Получить("Дата") = Неопределено Тогда
			Ошибка(Ошибки, "header.Дата", "Дата документа обязательна: строка YYYY-MM-DDTHH:MM:SS");
		КонецЕсли;
	КонецЕсли;
	Таблицы = Данные.Получить("tables");
	Если Таблицы = Неопределено Тогда
		Возврат Результат;
	ИначеЕсли ТипЗнч(Таблицы) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "tables", "Требуется объект tables: имя табличной части → массив строк");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Таблицы Цикл
		Путь = "tables." + Элемент.Ключ;
		Описание = НайтиОписание(Схема.tables, Элемент.Ключ);
		Если Описание = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестная табличная часть");
			Продолжить;
		КонецЕсли;
		Если Не Описание.writable Тогда
			Ошибка(Ошибки, Путь, Описание.reason);
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент.Значение) <> Тип("Массив") Тогда
			Ошибка(Ошибки, Путь, "Требуется массив строк");
			Продолжить;
		КонецЕсли;
		МетаТаблицы = Мета.ТабличныеЧасти.Найти(Описание.name);
		Строки = Новый Массив;
		Индекс = 0;
		Для Каждого СтрокаДанных Из Элемент.Значение Цикл
			ПутьСтроки = Путь + "[" + Формат(Индекс, "ЧГ=0") + "]";
			СтрокаТипизированная = Новый Соответствие;
			Если ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Тогда
				Ошибка(Ошибки, ПутьСтроки, "Требуется объект строки: имя поля → значение");
			Иначе
				ПодготовитьПоля(СтрокаДанных, Описание.fields, МетаТаблицы, ПутьСтроки, СтрокаТипизированная, Ошибки);
			КонецЕсли;
			Строки.Добавить(СтрокаТипизированная);
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.tables.Вставить(Описание.name, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПодготовитьПоля(Вход, Поля, МетаВладельца, Префикс, Выход, Ошибки)
	// Имена из тела сверяются с описанием до обращения к метаданным.
	Для Каждого Элемент Из Вход Цикл
		Путь = Префикс + "." + Элемент.Ключ;
		Поле = НайтиОписание(Поля, Элемент.Ключ);
		Если Поле = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестное поле");
			Продолжить;
		КонецЕсли;
		Если Не Поле.writable Тогда
			Ошибка(Ошибки, Путь, Поле.reason);
			Продолжить;
		КонецЕсли;
		// Родитель справочника с иерархией групп принимает только группу.
		Родитель = Префикс = "header" И Поле.name = "Родитель" И СчетаМагазинаМетаданные.ЭтоСправочник(МетаВладельца);
		ТипыПоля = СчетаМагазинаМетаданные.ТипыПоля(МетаВладельца, Поле.name);
		ОшибокДо = Ошибки.Количество();
		Значение = Преобразовать(Элемент.Значение, Поле, ТипыПоля, Родитель, Путь, Ошибки);
		Если ОшибокДо = Ошибки.Количество() Тогда
			Выход.Вставить(Поле.name, Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция Преобразовать(Вход, Поле, ТипыПоля, Родитель, Путь, Ошибки)
	// null: штатное пустое значение поля, у составного также {"type": …, "value": null}.
	Если Вход = Неопределено Тогда
		Возврат ТипыПоля.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Типы = ТипыПоля.Типы();
	ИндексТипа = 0;
	Если Поле.types.Количество() > 1 Тогда
		Если ТипЗнч(Вход) <> Тип("Соответствие") Тогда
			Ошибка(Ошибки, Путь, "Составной тип требует объект type и value");
			Возврат Неопределено;
		КонецЕсли;
		ЕстьЗначение = Ложь;
		Для Каждого Ключ Из Вход Цикл
			Если Ключ.Ключ = "value" Тогда
				ЕстьЗначение = Истина;
			ИначеЕсли Ключ.Ключ <> "type" Тогда
				Ошибка(Ошибки, Путь, "Неизвестное поле типизированного значения");
			КонецЕсли;
		КонецЦикла;
		ИндексТипа = -1;
		Для Индекс = 0 По Поле.types.Количество() - 1 Цикл
			Если Поле.types[Индекс].name = Вход.Получить("type") Тогда
				ИндексТипа = Индекс;
			КонецЕсли;
		КонецЦикла;
		Если ИндексТипа = -1 Или Не ЕстьЗначение Тогда
			Ошибка(Ошибки, Путь, "Недопустимый type либо отсутствует value");
			Возврат Неопределено;
		КонецЕсли;
		Вход = Вход.Получить("value");
	КонецЕсли;
	Описание = Поле.types[ИндексТипа];
	Если Вход = Неопределено Тогда
		ОдинТип = Новый Массив;
		ОдинТип.Добавить(Типы[ИндексТипа]);
		ОписаниеОдногоТипа = Новый ОписаниеТипов(ОдинТип);
		Возврат ОписаниеОдногоТипа.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Корректно = Ложь;
	Результат = Неопределено;
	Если Описание.kind = "string" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Строка");
		Если Корректно Тогда
			Корректно = Описание.length = 0 Или СтрДлина(Вход) <= Описание.length;
			Если Описание.fixedLength И Описание.length > 0 Тогда
				Корректно = СтрДлина(Вход) = Описание.length;
			КонецЕсли;
		КонецЕсли;
		Результат = Вход;
	ИначеЕсли Описание.kind = "number" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Число");
		// Разрядность 0: число без ограничения разрядности и точности.
		Если Корректно И Описание.digits > 0 Тогда
			Корректно = Окр(Вход, Описание.fractionDigits) = Вход
				И ?(Вход < 0, -Вход, Вход) < Pow(10, Описание.digits - Описание.fractionDigits);
		КонецЕсли;
		Корректно = Корректно И (Не Описание.nonnegative Или Вход >= 0);
		Результат = Вход;
	ИначеЕсли Описание.kind = "boolean" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Булево");
		Результат = Вход;
	ИначеЕсли Описание.kind = "date" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Попытка
				ТолькоДата = Описание.parts = "date";
				// Дата без времени читается как полночь; сравнение со входом отсекает зону, Z и лишнее.
				Результат = ПрочитатьДатуJSON(?(ТолькоДата, Вход + "T00:00:00", Вход), ФорматДатыJSON.ISO);
				Корректно = Вход = ДатаСтрокой(Результат, ТолькоДата);
			Исключение
				Корректно = Ложь;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли Описание.kind = "ref" Тогда
		Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
		Если Идентификатор <> Неопределено Тогда
			МетаСсылки = Метаданные.НайтиПоТипу(Типы[ИндексТипа]);
			Результат = СсылкаПоИдентификатору(МетаСсылки, Идентификатор);
			Корректно = СсылкаДоступна(МетаСсылки, Результат, Родитель);
		КонецЕсли;
	ИначеЕсли Описание.kind = "enum" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Для Каждого ЗначениеМета Из Описание.values Цикл
				Если Вход = ЗначениеМета.name Тогда
					Результат = Перечисления[Метаданные.НайтиПоТипу(Типы[ИндексТипа]).Имя][Вход];
					Корректно = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	// Один текст для любой неверной ссылки: не раскрывается, существует ли недоступный объект.
	Если Не Корректно Тогда
		Ошибка(Ошибки, Путь, "Недопустимое значение, тип, ограничение или ссылка; ожидается " + Описание.name);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СсылкаДоступна(Мета, Ссылка, Родитель)
	// Мета найдена по типу поля в метаданных, а не по пользовательской строке.
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + СчетаМагазинаМетаданные.ИмяТипа(Мета)
		+ " ГДЕ Ссылка = &Ссылка И НЕ ПометкаУдаления" + УсловиеЭлементов(Мета, Родитель);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Попытка
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Ложь;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция УсловиеЭлементов(Мета, Родитель)
	// Справочник с иерархией групп: ссылка на элемент, а Родитель: на группу.
	Если СчетаМагазинаМетаданные.ЭтоСправочник(Мета) И Мета.Иерархический
		И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат ?(Родитель, " И ЭтоГруппа", " И НЕ ЭтоГруппа");
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СсылкаПоИдентификатору(Мета, Идентификатор)
	Если СчетаМагазинаМетаданные.ЭтоСправочник(Мета) Тогда
		Возврат Справочники[Мета.Имя].ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Возврат Документы[Мета.Имя].ПолучитьСсылку(Идентификатор);
КонецФункции

Функция НовыйОбъект(Мета) Экспорт
	// Без обработки заполнения: Заполнить() не вызывается.
	Если СчетаМагазинаМетаданные.ЭтоСправочник(Мета) Тогда
		Возврат Справочники[Мета.Имя].СоздатьЭлемент();
	КонецЕсли;
	Возврат Документы[Мета.Имя].СоздатьДокумент();
КонецФункции

Процедура Заполнить(Объект, Подготовленные) Экспорт
	Для Каждого Поле Из Подготовленные.header Цикл
		Объект[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	Для Каждого Таблица Из Подготовленные.tables Цикл
		Для Каждого СтрокаДанных Из Таблица.Значение Цикл
			СтрокаОбъекта = Объект[Таблица.Ключ].Добавить();
			Для Каждого Поле Из СтрокаДанных Цикл
				СтрокаОбъекта[Поле.Ключ] = Поле.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция НайтиОбъекты(Мета, Знач СтрокаПоиска, Лимит, Ошибка) Экспорт
	Ошибка = Неопределено;
	Поиск = СчетаМагазинаМетаданные.ПолеПоиска(Мета);
	Если Поиск = Неопределено Тогда
		Ошибка = Новый Структура("code,message", "bad_request", "Поиск по этому типу не поддерживается");
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("items,hasMore", Новый Массив, Ложь);
	Справочник = СчетаМагазинаМетаданные.ЭтоСправочник(Мета);
	Запрос = Новый Запрос;
	Если Поиск.match = "exact" Тогда
		Если СтрокаПоиска = "" Или СтрРазделить(СтрокаПоиска, "0123456789", Ложь).Количество() > 0 Тогда
			Ошибка = Новый Структура("code,message", "bad_request",
				"Поле " + Поиск.field + " числовое: q должна быть целым числом из цифр");
			Возврат Неопределено;
		КонецЕсли;
		// Ведущие нули не меняют число; число длиннее поля не совпадёт ни с одним кодом или номером.
		Пока СтрДлина(СтрокаПоиска) > 1 И Лев(СтрокаПоиска, 1) = "0" Цикл
			СтрокаПоиска = Сред(СтрокаПоиска, 2);
		КонецЦикла;
		ДлинаПоля = ?(Справочник, Мета.ДлинаКода, Мета.ДлинаНомера);
		Если СтрДлина(СтрокаПоиска) > ДлинаПоля Тогда
			Возврат Результат;
		КонецЕсли;
		Условие = Поиск.field + " = &Значение";
		Запрос.УстановитьПараметр("Значение", Число(СтрокаПоиска));
	Иначе
		Условие = Поиск.field + " ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
		Запрос.УстановитьПараметр("Шаблон", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(СтрокаПоиска) + "%");
	КонецЕсли;
	// Ключ: имя в выдаче, значение: поле запроса.
	Колонки = Новый Структура;
	Если Справочник Тогда
		Если Мета.ДлинаКода > 0 Тогда
			Колонки.Вставить("code", "Код");
		КонецЕсли;
		Если Мета.ДлинаНаименования > 0 Тогда
			Колонки.Вставить("name", "Наименование");
		КонецЕсли;
		Если Мета.Иерархический И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			Колонки.Вставить("isFolder", "ЭтоГруппа");
		КонецЕсли;
		Если Мета.Владельцы.Количество() > 0 Тогда
			Колонки.Вставить("owner", "Владелец");
		КонецЕсли;
		Порядок = Поиск.field + ", Ссылка";
	Иначе
		Колонки.Вставить("number", "Номер");
		Колонки.Вставить("date", "Дата");
		Колонки.Вставить("posted", "Проведен");
		Порядок = "Дата УБЫВ, Ссылка";
	КонецЕсли;
	Поля = "Ссылка";
	Для Каждого Колонка Из Колонки Цикл
		Поля = Поля + ", " + Колонка.Значение;
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + " " + Поля
		+ " ИЗ " + СчетаМагазинаМетаданные.ИмяТипа(Мета)
		+ " ГДЕ НЕ ПометкаУдаления И " + Условие + " УПОРЯДОЧИТЬ ПО " + Порядок;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.items.Количество() = Лимит Тогда
			Результат.hasMore = Истина;
			Прервать;
		КонецЕсли;
		Элемент = Новый Структура("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Для Каждого Колонка Из Колонки Цикл
			Значение = Выборка[Колонка.Значение];
			Если Колонка.Ключ = "date" Тогда
				Значение = ДатаСтрокой(Значение);
			ИначеЕсли Колонка.Ключ = "owner" Тогда
				Значение = ВладелецJSON(Значение, Мета.Владельцы.Количество() > 1);
			КонецЕсли;
			Элемент.Вставить(Колонка.Ключ, Значение);
		КонецЦикла;
		Результат.items.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВладелецJSON(Владелец, Составной)
	Значение = ?(ЗначениеЗаполнено(Владелец), Строка(Владелец.УникальныйИдентификатор()), Неопределено);
	Если Не Составной Или Владелец = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	// Имя типа владельца, как в owners описания типа.
	МетаВладельца = Владелец.Метаданные();
	ИмяВладельца = ?(СчетаМагазинаМетаданные.ЭтоСправочник(МетаВладельца),
		СчетаМагазинаМетаданные.ИмяТипа(МетаВладельца), МетаВладельца.ПолноеИмя());
	Возврат Новый Структура("type,value", ИмяВладельца, Значение);
КонецФункции

Функция Прочитать(Мета, Идентификатор) Экспорт
	// Неопределено: объекта нет или он недоступен пользователю; какой из случаев, не раскрывается.
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Справочник = СчетаМагазинаМетаданные.ЭтоСправочник(Мета);
	Ссылка = СсылкаПоИдентификатору(Мета, Идентификатор);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + СчетаМагазинаМетаданные.ИмяТипа(Мета) + " ГДЕ Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Использование «для группы» и «для элемента» действует только при иерархии групп.
	Группы = Справочник И Мета.Иерархический
		И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	ЭтоГруппа = Группы И Объект.ЭтоГруппа;
	Результат = Новый Структура("type,id,header,tables", СчетаМагазинаМетаданные.ИмяТипа(Мета),
		Строка(Ссылка.УникальныйИдентификатор()), Новый Соответствие, Новый Соответствие);
	Схема = СчетаМагазинаМетаданные.Схема(Мета);
	Для Каждого Поле Из Схема.fields Цикл
		// Стандартных реквизитов нет в Реквизиты: они есть и у групп, и у элементов.
		Если Группы И Не Используется(Мета.Реквизиты.Найти(Поле.name), ЭтоГруппа) Тогда
			Продолжить;
		КонецЕсли;
		Типы = СчетаМагазинаМетаданные.ТипыПоля(Мета, Поле.name);
		Результат.header.Вставить(Поле.name, ЗначениеJSON(Объект[Поле.name], Поле, Типы));
	КонецЦикла;
	Для Каждого Таблица Из Схема.tables Цикл
		МетаТаблицы = Мета.ТабличныеЧасти.Найти(Таблица.name);
		Если Группы И Не Используется(МетаТаблицы, ЭтоГруппа) Тогда
			Продолжить;
		КонецЕсли;
		ТипыПолей = Новый Массив;
		Для Каждого Поле Из Таблица.fields Цикл
			ТипыПолей.Добавить(СчетаМагазинаМетаданные.ТипыПоля(МетаТаблицы, Поле.name));
		КонецЦикла;
		Строки = Новый Массив;
		Для Каждого СтрокаОбъекта Из Объект[Таблица.name] Цикл
			СтрокаJSON = Новый Соответствие;
			Для Индекс = 0 По Таблица.fields.ВГраница() Цикл
				Поле = Таблица.fields[Индекс];
				СтрокаJSON.Вставить(Поле.name, ЗначениеJSON(СтрокаОбъекта[Поле.name], Поле, ТипыПолей[Индекс]));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Результат.tables.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Используется(МетаОбъекта, ЭтоГруппа)
	Если МетаОбъекта = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Варианты = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита;
	Если ЭтоГруппа Тогда
		Возврат МетаОбъекта.Использование <> Варианты.ДляЭлемента;
	КонецЕсли;
	Возврат МетаОбъекта.Использование <> Варианты.ДляГруппы;
КонецФункции

Функция ЗначениеJSON(Значение, Поле, ТипыПоля)
	// Пустое значение составного поля.
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Тип значения сопоставляется с types поля по позиции, как при записи.
	Индекс = ТипыПоля.Типы().Найти(ТипЗнч(Значение));
	Если Индекс = Неопределено Тогда
		Возврат НеподдерживаемоеЗначение(Значение);
	КонецЕсли;
	Описание = Поле.types[Индекс];
	Если Описание.kind = "unsupported" Тогда
		Возврат НеподдерживаемоеЗначение(Значение);
	ИначеЕсли Описание.kind = "ref" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), Строка(Значение.УникальныйИдентификатор()), Неопределено);
	ИначеЕсли Описание.kind = "enum" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ОбщегоНазначения.ИмяЗначенияПеречисления(Значение), Неопределено);
	ИначеЕсли Описание.kind = "date" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ДатаСтрокой(Значение, Описание.parts = "date"), Неопределено);
	Иначе
		Результат = Значение;
	КонецЕсли;
	Если Поле.types.Количество() > 1 Тогда
		Возврат Новый Структура("type,value", Описание.name, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция НеподдерживаемоеЗначение(Значение)
	Попытка
		Представление = Строка(Значение);
	Исключение
		// Ссылка на объект, тип которого пользователю не доступен для чтения.
		Если Не ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			ВызватьИсключение;
		КонецЕсли;
		Представление = Строка(ТипЗнч(Значение));
	КонецПопытки;
	Возврат Новый Структура("unsupported,presentation", Истина, Представление);
КонецФункции

Функция ДатаСтрокой(Значение, ТолькоДата = Ложь) Экспорт
	Результат = Формат(Значение, "ДФ=yyyy-MM-dd");
	Если Не ТолькоДата Тогда
		Результат = Результат + "T" + Формат(Значение, "ДФ=HH:mm:ss");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция УникальныйИдентификаторИзСтроки(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Результат = Новый УникальныйИдентификатор(Значение);
		Если НРег(Значение) = Строка(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция НайтиОписание(Описания, Имя) Экспорт
	Для Каждого Описание Из Описания Цикл
		Если Описание.name = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура Ошибка(Ошибки, Путь, Текст) Экспорт
	Ошибки.Добавить(Новый Структура("path,message", Путь, Текст));
КонецПроцедуры
