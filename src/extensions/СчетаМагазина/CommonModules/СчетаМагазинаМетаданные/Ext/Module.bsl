Функция НайтиТип(Знач ИмяТипа, Ошибка) Экспорт
	Ошибка = Неопределено;
	Если ТипЗнч(ИмяТипа) <> Тип("Строка") Тогда
		ИмяТипа = "";
	КонецЕсли;
	Части = СтрРазделить(СокрЛП(ИмяТипа), ".", Истина);
	Если Части.Количество() <> 2 Или Части[0] = "" Или Части[1] = "" Тогда
		Ошибка = Новый Структура("code,message", "bad_request",
			"Требуется имя типа вида Справочник.<Имя> или Документ.<Имя>");
		Возврат Неопределено;
	КонецЕсли;
	Вид = НРег(Части[0]);
	Если Вид = "справочник" Тогда
		Мета = НайтиПоИмени(Метаданные.Справочники, Части[1]);
	ИначеЕсли Вид = "документ" Тогда
		Мета = НайтиПоИмени(Метаданные.Документы, Части[1]);
	Иначе
		Ошибка = Новый Структура("code,message", "unsupported_type",
			"Поддерживаются только справочники и документы: Справочник.<Имя> или Документ.<Имя>");
		Возврат Неопределено;
	КонецЕсли;
	Если Мета = Неопределено Тогда
		Ошибка = Новый Структура("code,message", "type_not_found",
			"Тип не найден; найти тип по слову: /types?q=<слово>");
	КонецЕсли;
	Возврат Мета;
КонецФункции

Функция ИмяТипа(Мета) Экспорт
	Возврат ?(ЭтоСправочник(Мета), "Справочник.", "Документ.") + Мета.Имя;
КонецФункции

Функция ЭтоСправочник(Мета) Экспорт
	Возврат Метаданные.Справочники.Содержит(Мета);
КонецФункции

Функция НайтиТипы(Знач Слово) Экспорт
	Слово = ДляСравнения(Слово);
	Результат = Новый Массив;
	ДобавитьТипы(Результат, Метаданные.Справочники, "catalog", Слово);
	ДобавитьТипы(Результат, Метаданные.Документы, "document", Слово);
	Возврат Результат;
КонецФункции

Процедура ДобавитьТипы(Результат, Коллекция, Вид, Слово)
	Найденные = Новый СписокЗначений;
	Для Каждого Мета Из Коллекция Цикл
		Заголовок = Мета.Представление();
		Если (СтрНайти(ДляСравнения(Мета.Имя), Слово) > 0 Или СтрНайти(ДляСравнения(Заголовок), Слово) > 0)
			И ПравоДоступа("Чтение", Мета) Тогда
			Найденные.Добавить(ИмяТипа(Мета), Заголовок);
		КонецЕсли;
	КонецЦикла;
	Найденные.СортироватьПоЗначению();
	Для Каждого Элемент Из Найденные Цикл
		Результат.Добавить(Новый Структура("name,kind,title", Элемент.Значение, Вид, Элемент.Представление));
	КонецЦикла;
КонецПроцедуры

Функция НайтиПоИмени(Коллекция, Имя)
	// Регистр имени не важен; сравниваем явно, не полагаясь на то, как Найти учитывает регистр.
	Искомое = НРег(Имя);
	Для Каждого Мета Из Коллекция Цикл
		Если НРег(Мета.Имя) = Искомое Тогда
			Возврат Мета;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ДляСравнения(Текст)
	Возврат СтрЗаменить(НРег(Текст), "ё", "е");
КонецФункции

Функция Схема(Мета) Экспорт
	Результат = Новый Структура("name,kind,title", ИмяТипа(Мета), "document", Мета.Представление());
	Группы = Ложь;
	Если ЭтоСправочник(Мета) Тогда
		Результат.kind = "catalog";
		Результат.Вставить("hierarchy", Иерархия(Мета));
		Результат.Вставить("owners", Владельцы(Мета));
		Группы = Результат.hierarchy = "groups";
	КонецЕсли;
	Результат.Вставить("search", ПолеПоиска(Мета));
	Поля = Новый Массив;
	Для Каждого Реквизит Из Мета.СтандартныеРеквизиты Цикл
		Правило = ПравилоСтандартного(Мета, Реквизит.Имя);
		Если Правило.Описывается Тогда
			Поля.Добавить(ОписаниеПоля(Реквизит, Правило.Обязательно Или Обязателен(Реквизит), Правило.Причина));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Поля.Добавить(ОписаниеПоля(Реквизит, Обязателен(Реквизит), ПричинаГрупп(Реквизит, Группы)));
	КонецЦикла;
	Результат.Вставить("fields", Поля);
	Таблицы = Новый Массив;
	Для Каждого Таблица Из Мета.ТабличныеЧасти Цикл
		Таблицы.Добавить(ОписаниеТаблицы(Таблица, Группы));
	КонецЦикла;
	Результат.Вставить("tables", Таблицы);
	Результат.Вставить("rules", Правила());
	Возврат Результат;
КонецФункции

Функция Иерархия(Мета)
	Если Не Мета.Иерархический Тогда
		Возврат Неопределено;
	ИначеЕсли Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат "groups";
	КонецЕсли;
	Возврат "items";
КонецФункции

Функция Владельцы(Мета)
	Результат = Новый Массив;
	Для Каждого Владелец Из Мета.Владельцы Цикл
		// Владелец бывает и не справочником (план видов характеристик): тогда его полное имя в метаданных.
		Результат.Добавить(?(ЭтоСправочник(Владелец), ИмяТипа(Владелец), Владелец.ПолноеИмя()));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолеПоиска(Мета) Экспорт
	// Строковые код и номер ищутся подстрокой, числовые: точным совпадением.
	Если ЭтоСправочник(Мета) Тогда
		Если Мета.ДлинаНаименования > 0 Тогда
			Возврат Новый Структура("field,match", "Наименование", "substring");
		ИначеЕсли Мета.ДлинаКода > 0 Тогда
			Строковый = Мета.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка;
			Возврат Новый Структура("field,match", "Код", ?(Строковый, "substring", "exact"));
		КонецЕсли;
	ИначеЕсли Мета.ДлинаНомера > 0 Тогда
		Строковый = Мета.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Строка;
		Возврат Новый Структура("field,match", "Номер", ?(Строковый, "substring", "exact"));
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПравилоСтандартного(Мета, Имя)
	// Правила сервиса для стандартных реквизитов по таблице спецификации; пустая Причина: реквизит пишется.
	// Ссылка не описывается: это id.
	Правило = Новый Структура("Описывается,Обязательно,Причина", Имя <> "Ссылка", Ложь,
		"Сервис не записывает это стандартное поле");
	Если ЭтоСправочник(Мета) Тогда
		Если Имя = "Код" Тогда
			Правило.Описывается = Мета.ДлинаКода > 0;
			Правило.Причина = ?(Мета.Автонумерация, "Код назначает 1С", "");
		ИначеЕсли Имя = "Наименование" Тогда
			Правило.Описывается = Мета.ДлинаНаименования > 0;
			Правило.Причина = "";
		ИначеЕсли Имя = "Родитель" Тогда
			Правило.Описывается = Мета.Иерархический;
			Правило.Причина = "";
		ИначеЕсли Имя = "Владелец" Тогда
			Правило.Описывается = Мета.Владельцы.Количество() > 0;
			Правило.Обязательно = Истина;
			Правило.Причина = "";
		ИначеЕсли Имя = "ЭтоГруппа" Тогда
			Правило.Причина = "Создание групп не поддерживается";
		КонецЕсли;
	ИначеЕсли Имя = "Дата" Тогда
		Правило.Обязательно = Истина;
		Правило.Причина = "";
	ИначеЕсли Имя = "Номер" Тогда
		Правило.Причина = ?(Мета.Автонумерация, "Номер назначает 1С", "");
	ИначеЕсли Имя = "Проведен" Тогда
		Правило.Причина = "Сервис не проводит документы";
	КонецЕсли;
	Возврат Правило;
КонецФункции

Функция ОписаниеТаблицы(Таблица, Группы)
	Если Таблица.Имя = "ДополнительныеРеквизиты" Тогда
		Причина = "Дополнительные реквизиты и сведения БСП вне рамок сервиса";
	Иначе
		Причина = ПричинаГрупп(Таблица, Группы);
	КонецЕсли;
	Описание = Новый Структура("name,title,writable,required,fields", Таблица.Имя, Таблица.Представление(),
		Причина = "", Обязателен(Таблица), Новый Массив);
	// Стандартный реквизит НомерСтроки не описывается: номер строки задаёт позиция в массиве.
	Для Каждого Реквизит Из Таблица.Реквизиты Цикл
		Описание.fields.Добавить(ОписаниеПоля(Реквизит, Обязателен(Реквизит), Причина));
	КонецЦикла;
	Если Причина <> "" Тогда
		Описание.Вставить("reason", Причина);
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция ОписаниеПоля(Реквизит, Обязательно, Знач Причина)
	Типы = Новый Массив;
	ТипыРеквизита = Реквизит.Тип;
	Для Каждого ТипПоля Из ТипыРеквизита.Типы() Цикл
		Описание = ОписаниеТипа(ТипПоля, ТипыРеквизита);
		Типы.Добавить(Описание);
		Если Причина = "" И Описание.kind = "unsupported" Тогда
			Причина = "Тип значения не поддерживается сервисом: " + Описание.name;
		КонецЕсли;
	КонецЦикла;
	Поле = Новый Структура("name,title,writable,required,types", Реквизит.Имя, Реквизит.Представление(),
		Причина = "", Обязательно, Типы);
	Если Причина <> "" Тогда
		Поле.Вставить("reason", Причина);
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ПричинаГрупп(МетаОбъекта, Группы)
	Если Группы И МетаОбъекта.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы Тогда
		Возврат "Реквизит групп; создание групп не поддерживается";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция Обязателен(МетаОбъекта)
	Возврат МетаОбъекта.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
КонецФункции

Функция Правила()
	Результат = Новый Структура;
	Результат.Вставить("validation", "Окончательное решение об обязательности принимает штатная проверка заполнения 1С; "
		+ "required: подсказка по метаданным, у табличной части нужна хотя бы одна строка");
	Результат.Вставить("dates", "Дата: строка YYYY-MM-DD при parts=date и YYYY-MM-DDTHH:MM:SS при parts=dateTime, "
		+ "местное время базы; часовой пояс и Z не принимаются");
	Результат.Вставить("null", "null: штатное пустое значение поля (пустая ссылка, пустая дата); "
		+ "обязательность проверяет 1С");
	Результат.Вставить("references", "Ссылка (kind=ref): UUID объекта строкой; найти объект: searchUrl + &q=<строка>; "
		+ "ссылка на справочник с иерархией групп принимает только элемент (isFolder=false), а Родитель только группу. "
		+ "Перечисление (kind=enum): имя значения из values");
	Результат.Вставить("composite", "Поле с несколькими types составное: "
		+ "{""type"": ""<name из types>"", ""value"": <значение>}; "
		+ "пустое значение: {""type"": ""<name из types>"", ""value"": null}");
	Результат.Вставить("exactness", "Числа не округляются, строки не обрезаются: значение вне length, fixedLength, "
		+ "digits, fractionDigits или nonnegative отклоняется");
	Результат.Вставить("writable", "Поля и табличные части с writable=false не передаются: причина в reason");
	Результат.Вставить("filling", "Сервис не вызывает заполнение и не рассчитывает значения: "
		+ "суммы и прочие расчётные поля передаёт клиент");
	Возврат Результат;
КонецФункции

Функция ОписаниеТипа(ТипПоля, ОписаниеТиповПоля) Экспорт
	// Неподдерживаемый тип описывается представлением типа 1С.
	Описание = Новый Структура("name,kind", Строка(ТипПоля), "unsupported");
	Если ТипПоля = Тип("Строка") Тогда
		Описание.name = "string";
		Описание.kind = "string";
		Описание.Вставить("length", ОписаниеТиповПоля.КвалификаторыСтроки.Длина);
		Описание.Вставить("fixedLength", ОписаниеТиповПоля.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная);
	ИначеЕсли ТипПоля = Тип("Число") Тогда
		Описание.name = "number";
		Описание.kind = "number";
		Квалификатор = ОписаниеТиповПоля.КвалификаторыЧисла;
		Описание.Вставить("digits", Квалификатор.Разрядность);
		Описание.Вставить("fractionDigits", Квалификатор.РазрядностьДробнойЧасти);
		Описание.Вставить("nonnegative", Квалификатор.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);
	ИначеЕсли ТипПоля = Тип("Булево") Тогда
		Описание.name = "boolean";
		Описание.kind = "boolean";
	ИначеЕсли ТипПоля = Тип("Дата") Тогда
		Часть = ОписаниеТиповПоля.КвалификаторыДаты.ЧастиДаты;
		Если Часть <> ЧастиДаты.Время Тогда
			Описание.name = "date";
			Описание.kind = "date";
			Описание.Вставить("parts", ?(Часть = ЧастиДаты.Дата, "date", "dateTime"));
		КонецЕсли;
	Иначе
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если МетаТипа <> Неопределено Тогда
			Если ЭтоСправочник(МетаТипа) Или Метаданные.Документы.Содержит(МетаТипа) Тогда
				Описание.name = ИмяТипа(МетаТипа);
				Описание.kind = "ref";
				Описание.Вставить("searchUrl", "/search?type=" + Описание.name);
			ИначеЕсли Метаданные.Перечисления.Содержит(МетаТипа) Тогда
				Описание.name = "Перечисление." + МетаТипа.Имя;
				Описание.kind = "enum";
				Описание.Вставить("values", Новый Массив);
				Для Каждого ЗначениеМета Из МетаТипа.ЗначенияПеречисления Цикл
					Описание.values.Добавить(Новый Структура("name,title", ЗначениеМета.Имя, ЗначениеМета.Представление()));
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция ТипыПоля(МетаВладельца, ИмяПоля) Экспорт
	Реквизит = МетаВладельца.Реквизиты.Найти(ИмяПоля);
	Если Реквизит <> Неопределено Тогда
		Возврат Реквизит.Тип;
	КонецЕсли;
	Для Каждого Реквизит Из МетаВладельца.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = ИмяПоля Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Поле " + ИмяПоля + " не найдено в метаданных " + МетаВладельца.ПолноеИмя();
КонецФункции
