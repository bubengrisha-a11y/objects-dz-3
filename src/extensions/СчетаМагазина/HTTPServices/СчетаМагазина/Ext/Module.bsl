Функция НайтиТипы(Запрос)
	Попытка
		Слово = Запрос.ПараметрыЗапроса.Получить("q");
		Слово = ?(Слово = Неопределено, "", СокрЛП(Слово));
		Если Слово = "" Тогда
			Возврат ОтказJSON(400, "bad_request",
				"Требуется непустой параметр q: слово из имени или представления типа", "q");
		КонецЕсли;
		Возврат ОтветJSON(200, Новый Структура("items", СчетаМагазинаМетаданные.НайтиТипы(Слово)));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ОписатьТип(Запрос)
	Попытка
		Ответ = Неопределено;
		Мета = ТипИзПараметра(Запрос, "name", Ответ);
		Если Мета = Неопределено Тогда
			Возврат Ответ;
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.Схема(Мета));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция НайтиОбъекты(Запрос)
	Попытка
		Ответ = Неопределено;
		Мета = ТипИзПараметра(Запрос, "type", Ответ);
		Если Мета = Неопределено Тогда
			Возврат Ответ;
		КонецЕсли;
		СтрокаПоиска = Запрос.ПараметрыЗапроса.Получить("q");
		СтрокаПоиска = ?(СтрокаПоиска = Неопределено, "", СокрЛП(СтрокаПоиска));
		Если СтрокаПоиска = "" Тогда
			Возврат ОтказJSON(400, "bad_request", "Требуется непустой параметр q: строка поиска", "q");
		КонецЕсли;
		Лимит = ЛимитИзПараметра(Запрос);
		Если Лимит = Неопределено Тогда
			Возврат ОтказJSON(400, "bad_request", "Параметр limit: целое число от 1 до 100, по умолчанию 20", "limit");
		КонецЕсли;
		Ошибка = Неопределено;
		Результат = СчетаМагазинаДанные.Найти(Мета, СтрокаПоиска, Лимит, Ошибка);
		Если Результат = Неопределено Тогда
			// Тип без поля поиска: ошибка параметра type, иначе q не подходит к числовому полю.
			Путь = ?(СчетаМагазинаМетаданные.ПолеПоиска(Мета) = Неопределено, "type", "q");
			Возврат ОтказJSON(400, Ошибка.code, Ошибка.message, Путь);
		КонецЕсли;
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ЛимитИзПараметра(Запрос)
	// Неопределено: limit не целое число от 1 до 100.
	Значение = Запрос.ПараметрыЗапроса.Получить("limit");
	Если Значение = Неопределено Тогда
		Возврат 20;
	КонецЕсли;
	Если Не Цифры(Значение) Или СтрДлина(Значение) > 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Лимит = Число(Значение);
	Возврат ?(Лимит >= 1 И Лимит <= 100, Лимит, Неопределено);
КонецФункции

Функция ПрочитатьОбъект(Запрос)
	Попытка
		Ответ = Неопределено;
		Мета = ТипИзПараметра(Запрос, "type", Ответ);
		Если Мета = Неопределено Тогда
			Возврат Ответ;
		КонецЕсли;
		Идентификатор = Запрос.ПараметрыЗапроса.Получить("id");
		Идентификатор = СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки(Идентификатор);
		Если Идентификатор = Неопределено Тогда
			Возврат ОтказJSON(400, "bad_request",
				"Требуется параметр id: UUID объекта строкой из 36 символов", "id");
		КонецЕсли;
		Результат = СчетаМагазинаДанные.Прочитать(Мета, Идентификатор);
		Если Результат = Неопределено Тогда
			Возврат ОтказJSON(404, "not_found", "Объект не найден или недоступен", "id");
		КонецЕсли;
		Возврат ОтветJSON(200, Результат);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция СоздатьОбъект(Запрос)
	Попытка
		Если Не ТелоJSON(Запрос) Тогда
			Возврат ОтказJSON(415, "unsupported_media_type",
				"Тело запроса: Content-Type application/json, допустим charset=utf-8");
		КонецЕсли;
		Разобрано = Ложь;
		Данные = ПрочитатьТело(Запрос, Разобрано);
		Если Не Разобрано Тогда
			Возврат ОтказJSON(400, "bad_request", "Тело запроса не является одним значением JSON");
		ИначеЕсли ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			Возврат ОтказJSON(400, "bad_request", "Тело запроса: объект JSON с type, header и tables");
		КонецЕсли;
		Ошибка = Неопределено;
		Мета = СчетаМагазинаМетаданные.НайтиТип(Данные.Получить("type"), Ошибка);
		Если Мета = Неопределено Тогда
			// Тип в теле: ошибка запроса, а не отсутствующий ресурс.
			Код = ?(Ошибка.code = "unsupported_type", Ошибка.code, "bad_request");
			Возврат ОтказJSON(400, Код, Ошибка.message, "type");
		ИначеЕсли Не ПравоДоступа("Добавление", Мета) Тогда
			Возврат ОтказJSON(403, "forbidden",
				"Недостаточно прав на добавление объектов типа " + СчетаМагазинаМетаданные.ИмяТипа(Мета), "type");
		КонецЕсли;
		Ошибки = Новый Массив;
		Подготовленные = СчетаМагазинаДанные.Подготовить(Мета, Данные, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(400, "bad_request", "Запрос не прошёл проверку", Ошибки);
		КонецЕсли;
		Объект = СчетаМагазинаДанные.НовыйОбъект(Мета);
		СчетаМагазинаДанные.Заполнить(Объект, Подготовленные);
		Возврат ЗаписатьОбъект(Мета, Объект);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ТелоJSON(Запрос)
	// Content-Type: application/json, из параметров допустим только charset=utf-8.
	Значение = Неопределено;
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "content-type" Тогда
			Значение = Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Части = СтрРазделить(НРег(Значение), ";", Ложь);
	Если Части.Количество() = 0 Или СокрЛП(Части[0]) <> "application/json" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По Части.ВГраница() Цикл
		Если СтрЗаменить(Части[Индекс], " ", "") <> "charset=utf-8" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПрочитатьТело(Запрос, Разобрано)
	// Разобрано: тело целиком одно значение JSON, после него только пробельные символы.
	Разобрано = Ложь;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		Данные = ПрочитатьJSON(Чтение, Истина);
		Разобрано = Не Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		// Неверный JSON или хвост, который не читается как JSON: ошибка клиента.
		Разобрано = Ложь;
		Данные = Неопределено;
	КонецПопытки;
	Возврат Данные;
КонецФункции

Функция ЗаписатьОбъект(Мета, Объект)
	// Проверка заполнения и запись в одной транзакции; при отказе или исключении ничего не записано.
	// Заполнено: Неопределено, пока проверка заполнения не выполнена.
	Заполнено = Неопределено;
	НачатьТранзакцию();
	Попытка
		ПолучитьСообщенияПользователю(Истина);
		Заполнено = Объект.ПроверитьЗаполнение();
		Если Не Заполнено Тогда
			ВызватьИсключение "Штатная проверка заполнения отказала";
		КонецЕсли;
		// Сообщения после записи относятся только к записи.
		ПолучитьСообщенияПользователю(Истина);
		Если СчетаМагазинаМетаданные.ЭтоСправочник(Мета) Тогда
			Объект.Записать();
		Иначе
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Если Объект.Проведен Тогда
				ВызватьИсключение "Документ оказался проведён после записи без проведения";
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Информация = ИнформацияОбОшибке();
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Если Заполнено = Ложь Тогда
			Возврат ОшибкаJSON(422, "validation_failed", "Объект не прошёл проверку заполнения",
				ОшибкиЗаполнения(Сообщения, Объект));
		ИначеЕсли ЭтоНарушениеПрав(Информация) Или Сообщения.Количество() = 0 Тогда
			Возврат НепредвиденнаяОшибка(Информация);
		КонецЕсли;
		// Отказ при записи с сообщениями 1С: обработчики объекта, даты запрета изменения и т. п.
		ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(Информация));
		Возврат ОшибкаJSON(422, "validation_failed", "1С отклонила запись объекта", ОшибкиЗаполнения(Сообщения, Объект));
	КонецПопытки;
	// Объект уже записан: ошибка чтения не превращает ответ в 500, иначе клиент повторит создание.
	Попытка
		Результат = СчетаМагазинаДанные.Прочитать(Мета, Объект.Ссылка.УникальныйИдентификатор());
	Исключение
		ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат = Неопределено;
	КонецПопытки;
	Если Результат = Неопределено Тогда
		// Объект записан, но прочитать его не удалось или не позволяют ограничения доступа на уровне записей.
		Результат = Новый Структура("type,id", СчетаМагазинаМетаданные.ИмяТипа(Мета),
			Строка(Объект.Ссылка.УникальныйИдентификатор()));
	КонецЕсли;
	Возврат ОтветJSON(201, Результат);
КонецФункции

Функция ОшибкиЗаполнения(Сообщения, Объект)
	Ошибки = Новый Массив;
	Схема = СчетаМагазинаМетаданные.Схема(Объект.Метаданные());
	Для Каждого Сообщение Из Сообщения Цикл
		СчетаМагазинаДанные.Ошибка(Ошибки, ПутьПоля(Сообщение.Поле, Схема, Объект), Сообщение.Текст);
	КонецЦикла;
	Если Ошибки.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, Неопределено, "Штатная проверка заполнения отказала без сообщения");
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

Функция ПутьПоля(Знач ИмяПоля, Схема, Объект)
	// Только точное сопоставление метаданным, без угадывания поля по тексту сообщения.
	Если СтрНачинаетсяС(ИмяПоля, "Объект.") Тогда
		ИмяПоля = Сред(ИмяПоля, СтрДлина("Объект.") + 1);
	КонецЕсли;
	Если СчетаМагазинаДанные.НайтиОписание(Схема.fields, ИмяПоля) <> Неопределено Тогда
		Возврат "header." + ИмяПоля;
	КонецЕсли;
	Для Каждого Таблица Из Схема.tables Цикл
		Если Не СтрНачинаетсяС(ИмяПоля, Таблица.name + "[") Тогда
			Продолжить;
		КонецЕсли;
		Для Индекс = 0 По Объект[Таблица.name].Количество() - 1 Цикл
			Для Каждого Поле Из Таблица.fields Цикл
				Путь = Таблица.name + "[" + Формат(Индекс, "ЧГ=0") + "]." + Поле.name;
				Если ИмяПоля = Путь Тогда
					Возврат "tables." + Путь;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ТипИзПараметра(Запрос, ИмяПараметра, Ответ)
	Ответ = Неопределено;
	Ошибка = Неопределено;
	Мета = СчетаМагазинаМетаданные.НайтиТип(Запрос.ПараметрыЗапроса.Получить(ИмяПараметра), Ошибка);
	Если Мета = Неопределено Тогда
		Статус = ?(Ошибка.code = "type_not_found", 404, 400);
		Ответ = ОтказJSON(Статус, Ошибка.code, Ошибка.message, ИмяПараметра);
	ИначеЕсли Не ПравоДоступа("Чтение", Мета) Тогда
		Ответ = ОтказJSON(403, "forbidden",
			"Недостаточно прав на чтение типа " + СчетаМагазинаМетаданные.ИмяТипа(Мета), ИмяПараметра);
		Мета = Неопределено;
	КонецЕсли;
	Возврат Мета;
КонецФункции

Функция Цифры(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ОтветJSON(Статус, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Статус, Код, Текст, Подробности)
	Возврат ОтветJSON(Статус, Новый Структура("error", Новый Структура("code,message,details", Код, Текст, Подробности)));
КонецФункции

Функция ОтказJSON(Статус, Код, Текст, Путь = Неопределено)
	Подробности = Новый Массив;
	СчетаМагазинаДанные.Ошибка(Подробности, Путь, Текст);
	Возврат ОшибкаJSON(Статус, Код, Текст, Подробности);
КонецФункции

Функция ЭтоНарушениеПрав(Информация)
	Возврат Информация.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь);
КонецФункции

Функция НепредвиденнаяОшибка(Информация)
	Если ЭтоНарушениеПрав(Информация) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Информация));
	Возврат ОтказJSON(500, "internal_error", КраткоеПредставлениеОшибки(Информация));
КонецФункции
